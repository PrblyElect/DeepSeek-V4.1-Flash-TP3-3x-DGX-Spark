#!/usr/bin/env bash
# ds41-flash-tp3-up — one-command bring-up for DeepSeek-V4.1-Flash TP=3
# on 3× DGX Spark (B12X vLLM fork).
#
# Usage:
#   ./launch/ds41-flash-tp3-up preflight   # verify image, checkpoint, fabric
#   ./launch/ds41-flash-tp3-up stage-env    # copy config + launcher to all boxes
#   ./launch/ds41-flash-tp3-up start --yes  # launch head first, then the workers
#   ./launch/ds41-flash-tp3-up stop         # graceful stop all
#   ./launch/ds41-flash-tp3-up health       # check :8600 on head
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ENV_SRC="${ENV_SRC:-$SCRIPT_DIR/../config/cluster.env}"

say() { printf '\e[1;36m[ds41-tp3]\e[0m %s\n' "$*"; }
die() { printf '\e[1;31m[ds41-tp3]\e[0m FATAL: %s\n' "$*" >&2; exit 1; }

on() { ssh -o BatchMode=yes -o ConnectTimeout=8 "$1" "${@:2}"; }

# Resolve cluster.env ONCE, here, so every value below is a local
# expansion. A value that is resolved on the box instead would silently
# expand to empty there — that is the bug class this layout avoids.
load_env() {
  [ -r "$ENV_SRC" ] || die "cannot read $ENV_SRC"
  set -a
  # shellcheck disable=SC1090
  . "$ENV_SRC"
  set +a
}

# ---- cluster definition (set these in config/cluster.env) ----
load_env
SPARK_HEAD="${SPARK_HEAD:-spark-head.local}"     # head / rank 0
SPARK_A="${SPARK_A:-spark-a.local}"              # worker / rank 1
SPARK_B="${SPARK_B:-spark-b.local}"              # worker / rank 2
HEAD_IP="${HEAD_IP:-192.168.0.10}"               # head's management LAN IP
WORKER_A_IP="${WORKER_A_IP:-192.168.0.11}"
WORKER_B_IP="${WORKER_B_IP:-192.168.0.12}"

ALL_BOXES=("$SPARK_HEAD" "$SPARK_A" "$SPARK_B")
CONTAINER_NAME="${CONTAINER_NAME:-ds41-flash-tp3}"
REMOTE_DIR="${REMOTE_DIR:-ds41-flash-tp3}"       # landing dir on each box

# ---------------------------------------------------------------- preflight
do_preflight() {
  say "preflight: verifying image, checkpoint, fabric on all boxes"

  # The fabric placeholders must be filled in before any box is touched.
  case "${NCCL_IB_HCA:-}" in
    ""|EDIT_ME*) die "set NCCL_IB_HCA in $ENV_SRC (RoCE port pair, from ibdev2netdev)" ;;
  esac
  case "${NCCL_SOCKET_IFNAME:-}" in
    ""|EDIT_ME*) die "set NCCL_SOCKET_IFNAME in $ENV_SRC (management interface)" ;;
  esac

  for box in "${ALL_BOXES[@]}"; do
    say "  checking $box"
    # Quoting contract for this payload:
    #   $NAME        expands HERE (the reader's machine) -> a literal value
    #   \$NAME       expands ON THE BOX -> a remote variable
    #   \"           a literal double quote on the box
    # Every value the box needs is injected as a literal; the box then
    # works with its own variables. No value is resolved on the box.
    on "$box" "
      set -u
      img='$IMAGE'
      want_digest='$IMAGE_DIGEST'
      want_layers='$IMAGE_CONTENT_SHA256'
      ckpt='$MODEL_DIR'

      # 1. image present, with the expected manifest digest
      if ! docker image inspect \"\$img\" >/dev/null 2>&1; then
        echo '  MISSING: image not staged'; exit 1
      fi
      digests=\$(docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' \"\$img\" 2>/dev/null)
      case \"\$digests\" in
        *@\"\$want_digest\"*) ;;
        # No RepoDigest at all: the image was imported rather than pulled,
        # so it carries no Hub provenance. That is NOT a mismatch -- the
        # CONTENT check below is what pins the bytes, and it is exactly
        # the case the content hash exists for. Match the launcher here:
        # a missing digest warns, a DIFFERENT digest is fatal.
        '') echo '  WARN: image carries no Hub RepoDigest -- content is pinned below, provenance is not' ;;
        *) echo '  MISSING: image manifest digest mismatch (tag moved, or wrong image)'; exit 1 ;;
      esac

      # 2. image CONTENT identity - the layer list is what actually runs
      got_layers=\$(docker image inspect --format '{{range .RootFS.Layers}}{{println .}}{{end}}' \"\$img\" 2>/dev/null \
                   | sha256sum | cut -d' ' -f1)
      if [ \"\$got_layers\" != \"\$want_layers\" ]; then
        echo '  MISSING: image content mismatch'; exit 1
      fi

      # 3. checkpoint staged
      if [ ! -d \"\$ckpt\" ]; then
        echo '  MISSING: checkpoint not staged'; exit 1
      fi

      # 4. memory headroom (advisory; the load decides). MemAvailable reads ~0
      # on this unified-memory kernel (see the RAM-PROBE row in docs/FIXLOG.md),
      # so measure reclaimable headroom the same way the launcher does: free +
      # reclaimable slab + (active + inactive page cache - unevictable), all
      # from /proc/meminfo in kB.
      awk '/MemFree:/{f=\$2} /SReclaimable:/{s=\$2} /^Active\\(file\\):/{af=\$2} /^Inactive\\(file\\):/{inf=\$2} /Unevictable:/{u=\$2} END{h=(f+s+af+inf-u)/1048576; if (h < 8) printf \"  WARN: only %.1f GiB reclaimable headroom\\n\", h; else printf \"  headroom: %.1f GiB reclaimable\\n\", h}' /proc/meminfo

      echo '  OK'
    " || die "preflight failed on $box"
  done
  say "preflight: all boxes pass"
}

# ---------------------------------------------------------------- stage-env
do_stage_env() {
  say "stage-env: copying config + launcher to all boxes"
  for box in "${ALL_BOXES[@]}"; do
    say "  staging to $box"
    on "$box" "mkdir -p ~/$REMOTE_DIR/config ~/$REMOTE_DIR/tp3-kit" \
      || die "failed to create $REMOTE_DIR on $box"
    scp -q "$ENV_SRC" "$box:~$REMOTE_DIR/config/cluster.env" \
      || die "failed to stage cluster.env to $box"
    scp -q "$SCRIPT_DIR/start-tp3-fork.sh" "$box:~$REMOTE_DIR/start-tp3-fork.sh" \
      || die "failed to stage start-tp3-fork.sh to $box"
    # the WHOLE kit travels: the gates and manifest, the overlay tree the
    # bootstrap installs on every boot (KV-capacity, and the LM-head overlay
    # when its knob is set), and the optional sparknet fabric kit (env
    # templates + node-map template). If you built the transport wheel, it
    # rides along from tp3-kit/ as-is.
    scp -q -r "$SCRIPT_DIR/tp3-kit" "$box:~$REMOTE_DIR/" \
      || die "failed to stage tp3-kit to $box"
  done
  say "stage-env: done"
}

# ---------------------------------------------------------------- start
do_start() {
  local CONFIRM="${1:-}"
  [ "$CONFIRM" = "--yes" ] || { say "pass --yes to confirm"; exit 1; }

  say "start: dropping page cache on all boxes"
  for box in "${ALL_BOXES[@]}"; do
    on "$box" "sudo -n sh -c 'echo 3 > /proc/sys/vm/drop_caches' >/dev/null 2>&1 \
      || echo '  WARN: could not drop the page cache (passwordless sudo required)'; \
      docker rm -f $CONTAINER_NAME 2>/dev/null; true"
  done

  say "start: launching head ($SPARK_HEAD, rank 0)"
  on "$SPARK_HEAD" "
    cd ~/$REMOTE_DIR || exit 1
    test -f start-tp3-fork.sh || { echo '  MISSING: start-tp3-fork.sh not staged'; exit 1; }
    set -a; . config/cluster.env; set +a
    NODE_IP=$HEAD_IP NODE_RANK=0 ROLE=head GMU=\$GMU \
      setsid nohup bash start-tp3-fork.sh > /tmp/ds41-boot-head.log 2>&1 &
  " || die "head launch failed"
  sleep 15

  say "start: launching workers"
  on "$SPARK_A" "
    cd ~/$REMOTE_DIR || exit 1
    test -f start-tp3-fork.sh || { echo '  MISSING: start-tp3-fork.sh not staged'; exit 1; }
    set -a; . config/cluster.env; set +a
    NODE_IP=$WORKER_A_IP NODE_RANK=1 ROLE=worker HEAD_IP=$HEAD_IP GMU=\$GMU \
      setsid nohup bash start-tp3-fork.sh > /tmp/ds41-boot-w1.log 2>&1 &
  " || die "worker A launch failed"

  on "$SPARK_B" "
    cd ~/$REMOTE_DIR || exit 1
    test -f start-tp3-fork.sh || { echo '  MISSING: start-tp3-fork.sh not staged'; exit 1; }
    set -a; . config/cluster.env; set +a
    NODE_IP=$WORKER_B_IP NODE_RANK=2 ROLE=worker HEAD_IP=$HEAD_IP GMU=\$GMU \
      setsid nohup bash start-tp3-fork.sh > /tmp/ds41-boot-w2.log 2>&1 &
  " || die "worker B launch failed"

  say "start: all three launched; health in ~5–6 min"
  say "  check: curl http://$HEAD_IP:$PORT/health"
}

# ---------------------------------------------------------------- stop
do_stop() {
  say "stop: removing containers on all boxes"
  for box in "${ALL_BOXES[@]}"; do
    on "$box" "docker rm -f $CONTAINER_NAME 2>/dev/null; true"
  done
  say "stop: done"
}

# ---------------------------------------------------------------- health
do_health() {
  say "health: checking engine on $HEAD_IP:$PORT"
  on "$SPARK_HEAD" "curl -s -o /dev/null -w '%{http_code}\n' --max-time 6 \
    http://localhost:$PORT/health" | \
    while read -r code; do
      if [ "$code" = "200" ]; then
        say "health: UP (200)"
      else
        say "health: DOWN ($code)"
        exit 1
      fi
    done
}

# ---------------------------------------------------------------- main
case "${1:-}" in
  preflight)  do_preflight ;;
  stage-env)  do_stage_env ;;
  start)      do_start "${2:-}" ;;
  stop)       do_stop ;;
  health)     do_health ;;
  *)          echo "Usage: $0 {preflight|stage-env|start [--yes]|stop|health}"; exit 1 ;;
esac
