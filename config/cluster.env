# cluster.env — ds41-flash-tp3 (capacity profile)
# Source this on every box before launching.

# ---- image pin (the digest is mandatory; a floating tag can move
#      between boxes and silently de-shard the triangle)
#
# IMAGE_DIGEST is the manifest digest of the pinned tag. IMAGE_CONTENT_SHA256
# is the sha256 of the image's RootFS layer list — the CONTENT identity, which
# survives an import that carries no Hub RepoDigest. The preflight checks
# both: a DIFFERENT digest is fatal, and so is a different layer list, but an
# image with NO RepoDigest at all only warns — that is the imported case the
# content hash exists for. A box whose bytes differ is not the image this
# recipe was tested on.
IMAGE="eugr/spark-vllm-b12x:nightly-20261015"
IMAGE_DIGEST="sha256:03a956544e9f9b4b7ba91690469fbe7848bdbef29a7d2e0f5788368467bb3595"
IMAGE_CONTENT_SHA256="41e4f9a3005bca761eb883c6565c1a3667cfbb014d49ec3d97735c7cfe146616"

# ---- fabric (EDIT THESE — they are site-specific; the preflight refuses
#      to run while they still hold the placeholder)
# RoCE port pair: find it with `ibdev2netdev` on each box.
NCCL_IB_HCA="${NCCL_IB_HCA:-EDIT_ME_ROCE_PORT_PAIR}"
# Management interface that carries the 192.168.0.10-12 addressing.
NCCL_SOCKET_IFNAME="${NCCL_SOCKET_IFNAME:-EDIT_ME_MGMT_IF}"


# ---- cluster (EDIT THESE -- the launcher reads them from here)
SPARK_HEAD="${SPARK_HEAD:-spark-head.local}"     # head / rank 0
SPARK_A="${SPARK_A:-spark-a.local}"              # worker / rank 1
SPARK_B="${SPARK_B:-spark-b.local}"              # worker / rank 2
HEAD_IP="${HEAD_IP:-192.168.0.10}"               # head's management LAN IP
WORKER_A_IP="${WORKER_A_IP:-192.168.0.11}"
WORKER_B_IP="${WORKER_B_IP:-192.168.0.12}"
CONTAINER_NAME="${CONTAINER_NAME:-ds41-flash-tp3}"

# ---- checkpoint
# This path must be the path ON EACH BOX (the launcher reads it from here
# and checks it over ssh). Replace YOURUSER with the account that owns the
# checkpoint on your boxes.
MODEL_DIR="${MODEL_DIR:-/home/YOURUSER/models/deepseek-v4.1-flash-1017-1bae0e10}"

# ---- memory (the capacity-first triangle)
GMU="${GMU:-0.85}"                         # see README wall #4
KV_CACHE_MEMORY_BYTES="${KV_CACHE_MEMORY_BYTES:-5g}"   # ~4.7 GiB reservation (fixed by this pin)

# ---- context
# 1M: the pool bytes and block count are fixed by the reservation pin;
# with the capacity overlay the token figure is ~5.1M at both 512K and
# 1M (the steady/transient split stops charging every request the
# in-flight batches). Deep-prefill admission verified to ~900K; seven
# concurrent 512K prefills verified.
CTX="${CTX:-1048576}"

# ---- parallel prefills (see FIXLOG)
# A short request's first token beside a deep prefill drops from tens of
# seconds to single-digit seconds, at no measurable cost to the long
# prefill — the shared chunk budget absorbs the small prefill in the big
# one's gaps. Where it lands in that band is set by the decode share
# below (~4.6-4.8 s at 0.3-0.5, ~5.8 s at the shipped 0.2).
# PAR_PREFILLS=1 restores legacy single-lane behavior (the policy knob is
# then omitted: the engine requires the policy to trail a count above 1).
PAR_PREFILLS="${PAR_PREFILLS:-2}"
PREFILL_POLICY="${PREFILL_POLICY:-decode-aware}"

# ---- decode-under-prefill share (see the launcher's bootstrap comment)
# A short request DECODING while a deep prefill churns crawls at ~1.4
# tok/s without this (the scheduler alternates pure prefill-only and
# decode-only steps, so mixed-step caps never bind). The static share +
# the 2048/step contended-prefill cap fix it; 0.2 is the shipped posture.
# The measured ladder (paired, phase-locked, quality-gated at every
# rung): ~1.4 -> ~8-10 tok/s at 0.5, ~22 at 0.3, ~25 at 0.2 — at zero
# idle cost, the deep prefill's wall flat, and a short-request TTFT price
# of ~+1 s beside the same prefill (settled by paired same-boot A/B
# comparisons; the whole interval inside the +25 % ceiling the trade was
# measured against). Set it to
# "" in the launcher's environment for the legacy scheduler.
PREFILL_COMPUTE_SHARE="${PREFILL_COMPUTE_SHARE-0.2}"
PREFILL_TOKENS_PER_STEP="${PREFILL_TOKENS_PER_STEP:-2048}"

# ---- b12x kernel autotuner
# 0 (default) = heuristic kernel plans, shipped as prebuilt cubins: boots
# in roughly half the time of the tuned boots, measured decode parity, a
# one-time cold-prefill cost of a few percent per new document. 1 = per-
# shape benchmarking: slower boots, and the tuning arena self-budgets at
# HALF of free memory — on this unified-memory kernel it has OOM-killed
# boots. Retest only with a specific reason.
B12X_AUTOTUNE="${B12X_AUTOTUNE:-0}"

# ---- serving
# MoE backend: b12x is the measured-keep default (~31 tok/s solo, clean
# multi-stream parity, no memory cost). The kill switch below is REQUIRED
# with it (the general kernel carries the SwiGLU clamp; tiny-decode drops
# it). Set MOE_BACKEND="" for the engine's auto resolution (DEEPGEMM_MXFP4).
MOE_BACKEND="${MOE_BACKEND:-b12x}"
B12X_W4A8_TINY_DECODE="${B12X_W4A8_TINY_DECODE:-0}"   # clamp-critical: see README

# ---- b12x MoE routing (measured keep, 2026-11; opt-in, OFF by default)
# The b12x MoE decode kernel has two routing modes. "direct" streams each
# route's expert weights separately; "grouped" (the union) streams each
# distinct expert's weights once for the whole batch. The switch is one
# constant in the vendor module -- _DIRECT_ROUTING_MAX_ROUTED_ROWS = 32 --
# and "direct" is taken while the batch's routed rows (tokens x top-k) are at
# or below it.
#
# Set this to lower the threshold and the multi-row speculative verify takes
# the union path. Measured on the 3x Spark TP=3 triangle (DSpark k=3, four
# verify rows = 24 routed rows, one stream):
#
#     unset (incumbent, direct)  ~45.5 tok/s   MoE family ~22.4 ms
#     6 (grouped/union)          ~47.5 tok/s   MoE family ~19.3 ms   (+~4.5 %)
#
# Same kernel, same launch grid, the same launch count in both arms, ~14 %
# cheaper per call (~0.53 -> ~0.46 ms/call). Acceptance is unchanged (the
# routing is not an acceptance mechanism).
#
# The patch is applied IN the container by the launcher's existing bootstrap,
# before the engine imports the module, and it is VERIFIED: the old constant
# must appear exactly once or the boot fails loudly. Unset = the vendor file
# is not touched at all, so the default posture is byte-identical.
#
# WHICH SHAPES IT CAN ACT IN: routed_rows = tokens x top-k (top-6 here), and
# "direct" is taken while routed_rows <= 32 -- so the incumbent is direct up
# to 5 tokens in a step (30 rows) and grouped from 6 tokens (36 rows).
# Lowering the threshold to 6 leaves ONLY a single token in a step direct
# (6 rows) and groups everything from two tokens up (12 rows). Therefore:
#   * with spec ON (DSpark k=3, four verify rows = 24 routed rows at one
#     stream) the knob moves the one-stream number -- that is the +~4.5 %
#     measured above; from two streams up (8 tokens x 6 = 48 rows > 32) both
#     arms are already grouped, so the knob is a no-op there;
#   * with spec OFF (the default posture) one stream is 6 rows -- direct
#     under BOTH thresholds -- so the knob CANNOT act at one stream at all.
#     Its live regime is TWO TO FIVE concurrent streams (12-30 rows); from
#     six streams up both arms are grouped again. A measured arbitration
#     prices the knob's ceiling in that regime at ~+1 ms per forward
#     against a measured ~2 ms grouped-path overhead per forward — the
#     expected sign there is NEGATIVE, so treat it as a single-stream
#     spec-shape knob only.
# Set it to "" (the default) for the incumbent behaviour.
B12X_DIRECT_ROUTING_MAX_ROUTED_ROWS="${B12X_DIRECT_ROUTING_MAX_ROUTED_ROWS:-}"
PORT="${PORT:-8600}"
TP="${TP:-3}"
SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-main}"   # single alias; see wall #5
MAX_NUM_SEQS="${MAX_NUM_SEQS:-8}"
# 16384 was tested and rejected: OOM-killed both worker ranks during the
# b12x compile phase (see FIXLOG failure mode 9). Retest only with a
# memory plan (reduced GMU, post-load RAM check).
# Vision: images per prompt (the checkpoint carries a 32-layer ViT tower; the
# engine builds it, stubs it at 0, and serves it above 0 — verified live).
# The fork ships its own image processor (no preprocessor file needed).
LIMIT_MM="${LIMIT_MM:-{\"image\": 32}}"

MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS:-8192}"
BLOCK_SIZE="${BLOCK_SIZE:-256}"

# ---- loader (see README wall #3)
# b12x (O_DIRECT bounce path) is the measured-keep default: the model load
# drops from ~190 s (safetensors mmap) to ~32 s, pool and decode unchanged.
# It refuses nothing the safetensors path accepted (same hooks, same shards,
# ext4 O_DIRECT). safetensors remains the conservative fallback.
LOAD_FORMAT="${LOAD_FORMAT:-b12x}"
ENGRAM_CONFIG='{"cpu_offload":false,"table_memory":"disk"}'

# ---- decode-step kernels (measured keeps, 2026-11)
# LM head: the image hard-codes the cutlass MXFP8 GEMV for linear heads; the
# b12x backend already in the image is ~2.1x faster at the decode shape
# (M=1) with bit-identical output — worth ~+6% single-stream. "cutlass"
# restores the stock kernel. Requires the flashinfer.py overlay from the kit.
VLLM_MXFP8_LINEAR_BACKEND="${VLLM_MXFP8_LINEAR_BACKEND:-auto}"
# L2 prefetch: the DS4.1 indexer's prefetcher is worth ~5% (do NOT disable);
# a 12 MB persisting-L2 set-aside for the hot weights buys a further ~1–2%.
VLLM_DS41_L2_PREFETCH="${VLLM_DS41_L2_PREFETCH:-1}"
VLLM_GLM53_L2_PREFETCH_PERSIST_MB="${VLLM_GLM53_L2_PREFETCH_PERSIST_MB:-12}"
VLLM_L2_PREFETCH_GRID="${VLLM_L2_PREFETCH_GRID:-4}"

# ---- persistent b12x compile cache (optional, strongly recommended)
# A per-image host cache dir bind-mounted at /root/.cache/b12x cuts ~60 s
# from every cold start after the first, with zero decode change. Created by
# the launcher; set B12X_PERSISTENT_CACHE="" to disable.
B12X_PERSISTENT_CACHE="${B12X_PERSISTENT_CACHE:-1}"

# ---- one-shot RoCE transport (optional; see tp3-kit/sparknet/README.md)
# Off by default so the base recipe boots stock. To enable, export BOTH on
# every box's launch (the launcher refuses a half-armed boot) AND follow the
# sparknet kit's build steps (wheel + fenced NCCL + warmed caches):
#   VLLM_ENABLE_ROCE_ALLREDUCE=1 SPARKNET_ROCE_TOPOLOGY=direct
# Measured: ~+5% single-stream, +12-15% two-stream aggregate, no memory cost.


# ---- NCCL buffer caps (see README wall #1 — the critical unlock)
export NCCL_BUFFSIZE=1048576
export NCCL_LL128_BUFFSIZE=262144
export NCCL_PROTO="^LL128"
export NCCL_MAX_NCHANNELS=8

# ---- allocator
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
# the launcher also forwards MALLOC_ARENA_MAX=2 to the engine (see "Where
# the boot time goes")

# ---- parsers
TOOL_CALL_PARSER=deepseek_v41
REASONING_PARSER=deepseek_v41

# ---- docker hardening (see README wall #6)
SECURITY_OPTS="--security-opt seccomp=unconfined"
