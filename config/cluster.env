# cluster.env — ds41-flash-tp3 (the serving profile)
# Source this on every box before launching.

# ---- image pin (the digest is mandatory; a floating tag can move
#      between boxes and silently de-shard the triangle)
#
# IMAGE_DIGEST is the manifest digest of the pinned tag. IMAGE_CONTENT_SHA256
# is the sha256 of the image's RootFS layer list — the CONTENT identity, which
# survives an import that carries no Hub RepoDigest. The preflight checks
# both: a DIFFERENT digest is fatal, and so is a different layer list, but an
# image with NO RepoDigest at all only warns — that is the imported case the
# content hash exists for. A box whose bytes differ is not the image this
# recipe was tested on.
IMAGE="eugr/spark-vllm-b12x:nightly-20261015"
IMAGE_DIGEST="sha256:03a956544e9f9b4b7ba91690469fbe7848bdbef29a7d2e0f5788368467bb3595"
IMAGE_CONTENT_SHA256="41e4f9a3005bca761eb883c6565c1a3667cfbb014d49ec3d97735c7cfe146616"

# ---- fabric (EDIT THESE — they are site-specific; the preflight refuses
#      to run while they still hold the placeholder)
# RoCE port pair: find it with `ibdev2netdev` on each box.
NCCL_IB_HCA="${NCCL_IB_HCA:-EDIT_ME_ROCE_PORT_PAIR}"
# Management interface that carries the 192.168.0.10-12 addressing.
NCCL_SOCKET_IFNAME="${NCCL_SOCKET_IFNAME:-EDIT_ME_MGMT_IF}"


# ---- cluster (EDIT THESE -- the launcher reads them from here)
SPARK_HEAD="${SPARK_HEAD:-spark-head.local}"     # head / rank 0
SPARK_A="${SPARK_A:-spark-a.local}"              # worker / rank 1
SPARK_B="${SPARK_B:-spark-b.local}"              # worker / rank 2
HEAD_IP="${HEAD_IP:-192.168.0.10}"               # head's management LAN IP
WORKER_A_IP="${WORKER_A_IP:-192.168.0.11}"
WORKER_B_IP="${WORKER_B_IP:-192.168.0.12}"
CONTAINER_NAME="${CONTAINER_NAME:-ds41-flash-tp3}"

# ---- checkpoint
# This path must be the path ON EACH BOX (the launcher reads it from here
# and checks it over ssh). Replace YOURUSER with the account that owns the
# checkpoint on your boxes.
MODEL_DIR="${MODEL_DIR:-/home/YOURUSER/models/deepseek-v4.1-flash-1017-1bae0e10}"

# ---- memory
GMU="${GMU:-0.85}"                         # see README wall #4

# ---- context
# 1M: the pool bytes and block count are fixed by the reservation pin;
# with the capacity overlay the token figure is ~5.1M at 1M (the
# accounting detail lives in the README's overlay section). The serving
# pool's whole-pool fill is certified clean end to end (FIXLOG 22); a
# heavier historical concurrent-fill receipt set belongs to the retired
# capacity form (FIXLOG 20-22).
CTX="${CTX:-1048576}"

# ---- SERVING PROFILE (interactive) — see README "Speculative
#      decode"
# KV 4.8g + DSpark k5 + ONE serialized prefill + the interactive-admission
# threshold + the host-hash kit. ~2x single-stream and ~2x 8-stream vs the
# no-spec lane; ~470 tok/s aggregate at 16 streams (see the README's carded table;
# whole-pool fill at this pool size certified clean — see FIXLOG 22 and
# patches/engram-host-hash/). The 3.0 GiB k=3 middle tier is documented
# in the README's Speculative decode section.
# Switch any block whole, never line by line:
KV_CACHE_MEMORY_BYTES="${KV_CACHE_MEMORY_BYTES:-4.8g}"   # ~4.8 GiB reservation (fixed by this pin)
# a brace-bearing default must never sit inside a ${VAR:-...} expansion
# (a } ends it early once the variable is set — see FIXLOG): assign the
# literal first, then the override-safe assignment.
SPEC_CFG_DEFAULT='{"method":"dspark","num_speculative_tokens":5,"draft_tensor_parallel_size":3,"draft_sample_method":"greedy","rejection_sample_method":"block"}'
SPEC_CFG="${SPEC_CFG:-$SPEC_CFG_DEFAULT}"
PAR_PREFILLS="${PAR_PREFILLS:-1}"   # serialized prefills keep decode batches pure (FIXLOG 19)
EXTRA_SERVE_ARGS="${EXTRA_SERVE_ARGS:---long-prefill-token-threshold 1024}"
# The threshold line is the interactive-admission fix (FIXLOG 21): without it
# a chat ARRIVING beside a deep prefill waits the whole prefill (~76 s beside
# a 350K context on this stack); with it the newcomer rides the residual
# step budget — ~1 s to first token, at every depth measured. Cost: deep
# prefill walls +31-41% (a solo 350K join 78 -> ~109 s). A conditional form
# (clip only when someone waits) recovers the walls but costs ~4 s arrivals
# — measured both ways; the shipped form optimizes for arrivals.
# (keep B12X_AUTOTUNE=0 and the FlashInfer autotune off; the adaptive
#  verifier is burst-only on this hardware — see FIXLOG 19)
# Host-hash kit, part of this profile: DS41_ENGRAM_HOST_HASH=1 arms the
# kit at patches/engram-host-hash/ once its manual, reversible install
# has been applied (see its README; apply AFTER the boot gate). The
# variable is inert on a stock engine tree and the kit works on either
# profile.
DS41_ENGRAM_HOST_HASH="${DS41_ENGRAM_HOST_HASH:-1}"

# ---- HISTORICAL: a no-spec capacity form (KV 5g, no drafter,
#      PAR_PREFILLS=2, no threshold clip) is recorded in FIXLOG 20-22 with
#      its receipts and the KV ceiling ladder (5.5g receipted, 6g ceiling).
#      On the current stack the serving profile's pool is within ~5% of it,
#      so it is no longer shipped as a profile; reconstruct it from FIXLOG
#      if that mission ever returns.

# PREFILL_POLICY is read only when PAR_PREFILLS is above 1 (the engine
# requires the policy to trail a count above 1); at the serialized count
# of the serving profile the launcher omits the knob entirely.
PREFILL_POLICY="${PREFILL_POLICY:-decode-aware}"

# ---- decode-under-prefill share (see the launcher's bootstrap comment)
# A short request DECODING while a deep prefill churns crawls at ~1.4
# tok/s without this (the scheduler alternates pure prefill-only and
# decode-only steps, so mixed-step caps never bind). The static share +
# the 2048/step contended-prefill cap fix it; 0.2 is the shipped posture
# (the TTFT figures in this comment are the
# parallel-prefill form — on the serialized serving profile arrivals are
# governed by the threshold block above).
# The measured ladder (paired, phase-locked, quality-gated at every
# rung): ~1.4 -> ~8-10 tok/s at 0.5, ~22 at 0.3, ~25 at 0.2 — at zero
# idle cost, the deep prefill's wall flat at 0.3/0.2 (+2-11 % at the
# first 0.5 rung), and a short-request TTFT of ~5-6 s versus ~4.6-4.8 s
# at the higher shares (+~7 %; settled by paired same-boot A/B
# comparisons, the whole interval inside the +25 % ceiling the trade was
# measured against). Set it to "" in the launcher's environment for the
# legacy scheduler.
PREFILL_COMPUTE_SHARE="${PREFILL_COMPUTE_SHARE-0.2}"
PREFILL_TOKENS_PER_STEP="${PREFILL_TOKENS_PER_STEP:-2048}"

# ---- THE 4096 DEEP-PREFILL LAYER (SHIPPED DEFAULT since v1.5.0 — the
#      memory-safe paired form; the 2048 conservative form is the
#      commented fallback below)
# Doubling the step (and the long-prefill clip BELOW MUST move with it —
# a clip left at 2048 silently caps the step back to 2048) measured, on
# this hardware class, roughly 10% faster deep prefills (solo and beside
# traffic; short-prefill rates move from the low-4K to the mid-4K tok/s
# class). The trade: a chat ARRIVING beside a long prefill waits roughly
# twice as long for its first token (~1 s -> ~2 s; still seconds-class).
# THE SECOND LINE (MAX_NUM_BATCHED_TOKENS) IS THE MEMORY HALF OF THE PAIR
# (FIXLOG 27): the prefill
# memory transient scales with MAX_NUM_BATCHED_TOKENS (the step budget),
# NOT with the per-request chunk — at the stock 8192 budget, concurrent
# cold prefills draw a ~1-1.5 GiB class transient of host available
# memory whatever the chunk size is. Capping the budget to 4096 halves
# that transient while KEEPING the layer's solo speed (a lone request's
# chunk fills the whole step either way); concurrent cold fills share the
# smaller step. Measured: four concurrent ~350K cold fills held worst-
# moment available memory in a ~0.6-0.8 GiB band, re-measured on a
# memory-drained lane with the same result, all completing at the
# layer's aggregate rate — and the full pool-envelope fill (EIGHT
# concurrent deep fills, the sequence cap saturated) completes end to
# end on the same pairing, never approaching the kernel-OOM line.
# DO NOT go above 4096 on this engine build: at a step of 8192 a waiting
# chat never joins a step (prefill-only steps consume the whole batch
# budget and the decode starves until the prefill finishes) — an arrival
# beside a ~350K prefill waits the ENTIRE prefill (~70 s). 4096 is the
# measured ceiling under this scheduler.
PREFILL_TOKENS_PER_STEP=4096
MAX_NUM_BATCHED_TOKENS=4096
# The conservative fallback (the pre-v1.5.0 default) — comment the three
# two lines above out and uncomment these:
#PREFILL_TOKENS_PER_STEP=2048
#MAX_NUM_BATCHED_TOKENS=8192

# ---- b12x kernel autotuner
# 0 (default) = heuristic kernel plans, shipped as prebuilt cubins: boots
# in roughly half the time of the tuned boots, measured decode parity, a
# one-time cold-prefill cost of a few percent per new document. 1 = per-
# shape benchmarking: slower boots, and the tuning arena self-budgets at
# HALF of free memory — and because it PRE-allocates that budget, the
# kernel OOM killer never fires: nothing fails to allocate, everything
# else on the host (login shells included) simply starves. A full-race
# boot on this stack wedged every box at the SSH layer. Retest only
# with a code-level arena bound; lowering the KV pool does not help
# (the arena scales with whatever is free).
B12X_AUTOTUNE="${B12X_AUTOTUNE:-0}"

# ---- serving
# MoE backend: b12x is the measured-keep default (~31 tok/s solo, clean
# multi-stream parity, no memory cost). The kill switch below is REQUIRED
# with it (the general kernel carries the SwiGLU clamp; tiny-decode drops
# it). Set MOE_BACKEND="" for the engine's auto resolution (DEEPGEMM_MXFP4).
MOE_BACKEND="${MOE_BACKEND:-b12x}"
B12X_W4A8_TINY_DECODE="${B12X_W4A8_TINY_DECODE:-0}"   # clamp-critical: see README

# ---- b12x MoE routing (opt-in, OFF by default)
# The b12x MoE decode kernel has two routing modes: "direct" (one
# expert-weight stream per route) while the batch's routed rows
# (tokens x top-k) are at or below the vendor constant
# _DIRECT_ROUTING_MAX_ROUTED_ROWS (32), and "grouped" above it (the
# union of the batch's experts, each streamed once). Setting this lowers
# the threshold; the launcher patches the constant in-container before
# anything imports the module and VERIFIES it (exactly one occurrence,
# or the boot fails loudly). Unset = the vendor file untouched, the
# default posture byte-identical.
# Measured (the DSpark k=3 verify shape, one stream): ~+4.5 % tok/s.
# With spec OFF the knob cannot act at one stream (6 routed rows —
# direct under both thresholds); its live regime is 2-5 concurrent
# streams, where a measured arbitration prices its ceiling (~+1 ms per
# forward) below the grouped path's own overhead (~2 ms per forward) —
# expected sign NEGATIVE. Treat it as a single-stream spec-shape knob
# only.
B12X_DIRECT_ROUTING_MAX_ROUTED_ROWS="${B12X_DIRECT_ROUTING_MAX_ROUTED_ROWS:-}"
PORT="${PORT:-8600}"
TP="${TP:-3}"
SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-main}"   # single alias; see wall #5
MAX_NUM_SEQS="${MAX_NUM_SEQS:-8}"   # 8; 16 extends the aggregate ladder
# 16384 was tested and rejected: OOM-killed both worker ranks during the
# b12x compile phase (see FIXLOG failure mode 9). Retest only with a
# memory plan (reduced GMU, post-load RAM check).
# Vision: images per prompt (the checkpoint carries a 32-layer ViT tower; the
# engine builds it, stubs it at 0, and serves it above 0 — verified live).
# The fork ships its own image processor (no preprocessor file needed).
LIMIT_MM_DEFAULT='{"image": 32}'   # single-quoted literal: a brace-bearing default must never sit inside a ${VAR:-...} expansion
LIMIT_MM="${LIMIT_MM:-$LIMIT_MM_DEFAULT}"

# MAX_NUM_BATCHED_TOKENS is set in the 4096-layer block above (the shipped
# default); the bare fallback is 8192 — see the memory-lever section.
BLOCK_SIZE="${BLOCK_SIZE:-256}"

# ---- loader (see README wall #3)
# b12x (O_DIRECT bounce path) is the measured-keep default: the model load
# drops from ~190 s (safetensors mmap) to ~32 s, pool and decode unchanged.
# It refuses nothing the safetensors path accepted (same hooks, same shards,
# ext4 O_DIRECT). safetensors remains the conservative fallback.
LOAD_FORMAT="${LOAD_FORMAT:-b12x}"
ENGRAM_CONFIG='{"cpu_offload":false,"table_memory":"disk"}'

# ---- decode-step kernels (measured keeps, 2026-11)
# Attention compute: "auto" lets the plan choose its FP8 internals (the
# vendor default this code path was pinning to BF16). Measured: counting
# +~6 %, prose decode +~19 %, quality/NaN/long-context-retrieval gates
# clean at adoption. Unset = the BF16 pin (the conservative fallback).
VLLM_DS41_ATTENTION_COMPUTE="${VLLM_DS41_ATTENTION_COMPUTE:-auto}"
# LM head: the image hard-codes the cutlass MXFP8 GEMV for linear heads; the
# b12x backend already in the image is ~2.1x faster at the decode shape
# (M=1) with bit-identical output — worth ~+6% single-stream. "cutlass"
# restores the stock kernel. Requires the flashinfer.py overlay from the kit.
VLLM_MXFP8_LINEAR_BACKEND="${VLLM_MXFP8_LINEAR_BACKEND:-auto}"
# L2 prefetch: the DS4.1 indexer's prefetcher is worth ~5% (do NOT disable);
# a 12 MB persisting-L2 set-aside for the hot weights buys a further ~1–2%.
VLLM_DS41_L2_PREFETCH="${VLLM_DS41_L2_PREFETCH:-1}"
VLLM_GLM53_L2_PREFETCH_PERSIST_MB="${VLLM_GLM53_L2_PREFETCH_PERSIST_MB:-12}"
VLLM_L2_PREFETCH_GRID="${VLLM_L2_PREFETCH_GRID:-4}"

# ---- persistent b12x compile cache (optional, strongly recommended)
# A per-image host cache dir bind-mounted at /root/.cache/b12x cuts ~60 s
# from every cold start after the first, with zero decode change. Created by
# the launcher; set B12X_PERSISTENT_CACHE="" to disable.
B12X_PERSISTENT_CACHE="${B12X_PERSISTENT_CACHE:-1}"

# ---- one-shot RoCE transport (optional; see tp3-kit/sparknet/README.md)
# Off by default so the base recipe boots stock. To enable, export BOTH on
# every box's launch (the launcher refuses a half-armed boot) AND follow the
# sparknet kit's build steps (wheel + fenced NCCL + warmed caches):
#   VLLM_ENABLE_ROCE_ALLREDUCE=1 SPARKNET_ROCE_TOPOLOGY=direct
# Measured: ~+5% single-stream, +12-15% two-stream aggregate, no memory cost.


# ---- NCCL buffer caps (see README wall #1 — the critical unlock)
export NCCL_BUFFSIZE=1048576
export NCCL_LL128_BUFFSIZE=262144
export NCCL_PROTO="^LL128"
export NCCL_MAX_NCHANNELS=8

# ---- allocator
# ADOPTED (2026-11): the original NaN warning did not reproduce; True+GC0.6
# boots clean, passes every numerical and capability gate, and buys ~1.9 GB
# of headroom at this posture. False is the conservative fallback.
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,garbage_collection_threshold:0.6
# the launcher also forwards MALLOC_ARENA_MAX=2 to the engine (see "Where
# the boot time goes")

# ---- parsers
TOOL_CALL_PARSER=deepseek_v41
REASONING_PARSER=deepseek_v41

# ---- fixed plumbing (documented for completeness; the values live in
# the launcher and are not tuning knobs)
# B12X_COMPILE_WORKERS=4        b12x compile parallelism — more workers raise
#                              the compile-phase memory spike (FIXLOG 9/11)
# VLLM_MXFP8_LM_HEAD=1         selects the faster LM-head kernel (the kit's
#                              flashinfer.py overlay supplies it)
# VLLM_ENABLE_PCIE_ALLREDUCE=0 the PCIe one-shot collective stays off
# CUTE_DSL_ARCH=sm_121a        kernel-compile target (GB10)
# RUNAI_STREAMER_MEMORY_LIMIT  the b12x reader's streaming-buffer cap (4 GiB)
# PYTHONPYCACHEPREFIX=/tmp/pycache   keeps bytecode off the read-only kit mount

# ---- docker hardening (see README wall #6)
SECURITY_OPTS="--security-opt seccomp=unconfined"
