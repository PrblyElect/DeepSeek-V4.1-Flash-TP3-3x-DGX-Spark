# cluster.env — ds41-flash-tp3 (capacity profile)
# Source this on every box before launching.

# ---- image pin (the digest is mandatory; a floating tag can move
#      between boxes and silently de-shard the triangle)
#
# IMAGE_DIGEST is the manifest digest of the pinned tag. IMAGE_CONTENT_SHA256
# is the sha256 of the image's RootFS layer list — the CONTENT identity, which
# survives an import that carries no Hub RepoDigest. The preflight asserts
# both; a box that fails either is not the image this recipe was tested on.
IMAGE="eugr/spark-vllm-b12x:nightly-20261015"
IMAGE_DIGEST="sha256:03a956544e9f9b4b7ba91690469fbe7848bdbef29a7d2e0f5788368467bb3595"
IMAGE_CONTENT_SHA256="41e4f9a3005bca761eb883c6565c1a3667cfbb014d49ec3d97735c7cfe146616"

# ---- fabric (EDIT THESE — they are site-specific; the preflight refuses
#      to run while they still hold the placeholder)
# RoCE port pair: find it with `ibdev2netdev` on each box.
NCCL_IB_HCA="${NCCL_IB_HCA:-EDIT_ME_ROCE_PORT_PAIR}"
# Management interface that carries the 192.168.0.10-12 addressing.
NCCL_SOCKET_IFNAME="${NCCL_SOCKET_IFNAME:-EDIT_ME_MGMT_IF}"


# ---- cluster (EDIT THESE -- the launcher reads them from here)
SPARK_HEAD="${SPARK_HEAD:-spark-head.local}"     # head / rank 0
SPARK_A="${SPARK_A:-spark-a.local}"              # worker / rank 1
SPARK_B="${SPARK_B:-spark-b.local}"              # worker / rank 2
HEAD_IP="${HEAD_IP:-192.168.0.10}"               # head's management LAN IP
WORKER_A_IP="${WORKER_A_IP:-192.168.0.11}"
WORKER_B_IP="${WORKER_B_IP:-192.168.0.12}"
CONTAINER_NAME="${CONTAINER_NAME:-ds41-flash-tp3}"

# ---- checkpoint
# This path must be the path ON EACH BOX (the launcher reads it from here
# and checks it over ssh). Replace YOURUSER with the account that owns the
# checkpoint on your boxes.
MODEL_DIR="${MODEL_DIR:-/home/YOURUSER/models/deepseek-v4.1-flash-1017-1bae0e10}"

# ---- memory (the capacity-first triangle)
GMU="${GMU:-0.85}"                         # see README wall #4
CTX="${CTX:-524288}"                       # 512K context
KV_CACHE_MEMORY_BYTES="${KV_CACHE_MEMORY_BYTES:-4g}"   # ~1.6–2.4M-token pool (boot-labile; band it)

# ---- serving
PORT="${PORT:-8600}"
TP="${TP:-3}"
SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-main}"   # single alias; see wall #5
MAX_NUM_SEQS="${MAX_NUM_SEQS:-8}"
MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS:-8192}"
BLOCK_SIZE="${BLOCK_SIZE:-256}"

# ---- loader (see README wall #3)
LOAD_FORMAT="${LOAD_FORMAT:-safetensors}"
ENGRAM_CONFIG='{"cpu_offload":false,"table_memory":"disk"}'

# ---- NCCL buffer caps (see README wall #1 — the critical unlock)
export NCCL_BUFFSIZE=1048576
export NCCL_LL128_BUFFSIZE=262144
export NCCL_PROTO="^LL128"
export NCCL_MAX_NCHANNELS=8

# ---- allocator
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False

# ---- parsers
TOOL_CALL_PARSER=deepseek_v41
REASONING_PARSER=deepseek_v41

# ---- docker hardening (see README wall #6)
SECURITY_OPTS="--security-opt seccomp=unconfined"
