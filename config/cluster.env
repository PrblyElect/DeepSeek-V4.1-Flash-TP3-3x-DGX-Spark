# cluster.env — ds41-flash-tp3 (capacity profile)
# Source this on every box before launching.

# ---- image pin (the digest is mandatory; a floating tag can move
#      between boxes and silently de-shard the triangle)
IMAGE="eugr/spark-vllm-b12x:nightly-20261015"
IMAGE_DIGEST="sha256:57c24fc397c66d4d28a7d0d5f1d792934fd01a70f4574cff6315fb7bc329d5cb"

# ---- checkpoint
MODEL_DIR="${MODEL_DIR:-$HOME/models/deepseek-v4.1-flash-1017-1bae0e10}"

# ---- memory (the capacity-first triangle)
GMU="${GMU:-0.85}"                         # see README wall #4
CTX="${CTX:-524288}"                       # 512K context
KV_CACHE_MEMORY_BYTES="${KV_CACHE_MEMORY_BYTES:-4g}"   # 1.6M-token pool

# ---- serving
PORT="${PORT:-8600}"
TP="${TP:-3}"
SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-main}"   # single alias; see wall #5
MAX_NUM_SEQS="${MAX_NUM_SEQS:-8}"
MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS:-8192}"
BLOCK_SIZE="${BLOCK_SIZE:-256}"

# ---- loader (see README wall #3)
LOAD_FORMAT="${LOAD_FORMAT:-safetensors}"
ENGRAM_CONFIG='{"cpu_offload":false,"table_memory":"disk"}'

# ---- NCCL buffer caps (see README wall #1 — the critical unlock)
export NCCL_BUFFSIZE=1048576
export NCCL_LL128_BUFFSIZE=262144
export NCCL_PROTO="^LL128"
export NCCL_MAX_NCHANNELS=8

# ---- allocator
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False

# ---- parsers
TOOL_CALL_PARSER=deepseek_v41
REASONING_PARSER=deepseek_v41

# ---- docker hardening (see README wall #6)
SECURITY_OPTS="--security-opt seccomp=unconfined"
